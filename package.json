{
  "name": "chhotu",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "pnpm cf-typegen && astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "astro sync && wrangler types .astro/worker-configuration.d.ts --strict-vars=false --include-runtime=false"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "@vite-pwa/astro": "^1.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "packageManager": "pnpm@10.29.3"
}

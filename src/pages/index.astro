---
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---

<Layout title="choose. | chhotu" home>
	<main class="home-main flex flex-col items-center justify-center gap-12 p-4">
		<h1 class="text-4xl md:text-2xl">choose.</h1>
		<a
			href="/snippets"
			class="route-link group flex min-h-20 min-w-20 items-center justify-center md:min-h-12 md:min-w-12"
			aria-label="snippets"
			title="snippets"
		>
			<span
				class="icon size-16 group-hover:scale-110 md:size-10"
				style="--icon-url: url(/icons/photo.svg)"
				aria-hidden="true"></span>
		</a>
	</main>
</Layout>
